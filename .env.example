# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# URL publique du site (canonical, sitemap, JSON-LD, redirections Stripe)
SITE_URL=http://localhost:8000
SITE_NAME=Maison Alliance
# Coordonnées affichées sur les fiches produit (laisser vide pour masquer)
SITE_PHONE=
SITE_WHATSAPP=
SITE_EMAIL=
# Délai de retour affiché sur les fiches produit (14 jours = minimum légal)
RETURN_DAYS=14

# --- Stripe ---
# Mode démo : paiements simulés sur une page locale, aucune carte débitée, aucun compte Stripe requis.
# Pour passer sur Stripe (mode test puis production) : STRIPE_DEMO_MODE=0 et renseigner les clés.
STRIPE_DEMO_MODE=1
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cours de l'or ---
# goldapi (recommandé, clé requise, cotation EUR native) | goldapicom (gratuit, USD converti via BCE) | manual
GOLD_PRICE_PROVIDER=goldapicom
GOLDAPI_KEY=
# Au-delà de cette ancienneté (minutes), le cours est jugé périmé : les paiements sont suspendus.
GOLD_PRICE_MAX_AGE_MINUTES=1440

# --- Coffret d'essai ---
TRIAL_KIT_MIN=8
TRIAL_KIT_MAX=12
# Prix du coffret en centimes : déduit de la commande d'alliances grâce à un code unique,
# non remboursé si aucune commande n'est passée.
TRIAL_KIT_PRICE_CENTS=8000
