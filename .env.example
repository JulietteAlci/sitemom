# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# URL publique du site (canonical, sitemap, JSON-LD, redirections Stripe)
SITE_URL=http://localhost:8000
SITE_NAME=Maison Alliance

# --- Stripe ---
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Cours de l'or ---
# goldapi (recommandé, clé requise, cotation EUR native) | goldapicom (gratuit, USD converti via BCE) | manual
GOLD_PRICE_PROVIDER=goldapicom
GOLDAPI_KEY=
# Au-delà de cette ancienneté (minutes), le cours est jugé périmé : les paiements sont suspendus.
GOLD_PRICE_MAX_AGE_MINUTES=1440

# --- Coffret d'essai ---
TRIAL_KIT_MIN=8
TRIAL_KIT_MAX=12
# Prix du coffret en centimes : déduit de la commande d'alliances grâce à un code unique,
# non remboursé si aucune commande n'est passée.
TRIAL_KIT_PRICE_CENTS=8000
