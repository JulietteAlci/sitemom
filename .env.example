# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# URL publique du site (canonical, sitemap, JSON-LD, redirections Stripe)
SITE_URL=http://localhost:8000
SITE_NAME=Maison Alliance
# Coordonnées affichées sur les fiches produit (laisser vide pour masquer)
SITE_PHONE=
SITE_WHATSAPP=
SITE_EMAIL=
# Délai de retour affiché sur les fiches produit (14 jours = minimum légal)
RETURN_DAYS=14

# --- Stripe ---
# Mode démo : paiements simulés sur une page locale, aucune carte débitée, aucun compte Stripe requis.
# Pour passer sur Stripe (mode test puis production) : STRIPE_DEMO_MODE=0 et renseigner les clés.
STRIPE_DEMO_MODE=1
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cours de l'or ---
# goldapi (recommandé, clé requise, cotation EUR native) | goldapicom (gratuit, USD converti via BCE) | manual
GOLD_PRICE_PROVIDER=goldapicom
GOLDAPI_KEY=
# Au-delà de cette ancienneté (minutes), le cours est jugé périmé : les paiements sont suspendus.
GOLD_PRICE_MAX_AGE_MINUTES=1440

# --- Coffret d'essai ---
# Nombre d'alliances par coffret (min = max = 4 : exactement 4)
TRIAL_KIT_MIN=4
TRIAL_KIT_MAX=4
# Montants en centimes : 100 € payés = 80 € déduits de la commande d'alliances (code unique)
# + 20 € remboursés au retour du coffret, une fois contrôlé par l'équipe.
TRIAL_KIT_PRICE_CENTS=10000
TRIAL_KIT_CREDIT_CENTS=8000
TRIAL_KIT_REFUND_CENTS=2000
# Jours pour renvoyer le coffret après livraison, délai de livraison estimé, fréquence des relances
TRIAL_KIT_RETURN_DAYS=8
TRIAL_KIT_DELIVERY_DAYS=2
TRIAL_KIT_REMINDER_EVERY_DAYS=2

# --- Adresse de l'atelier (étiquette retour, bon d'envoi) — \n pour les retours à la ligne ---
SHOP_ADDRESS=Maison Alliance — Atelier\n1 rue de l'Exemple\n69000 Lyon\nFrance

# --- E-mails ---
# Sans EMAIL_HOST, les e-mails s'affichent dans le terminal (pratique pour tester).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Maison Alliance <bonjour@example.com>
